generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HOMEOWNER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

// Owner or tenant of the unit.
enum OccupancyType {
  OWNER_OCCUPIED
  TENANT
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum DueStatus {
  UNPAID
  PAID
  WAIVED
}

enum PaymentMethod {
  GCASH
  BANK_TRANSFER
  EWALLET
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum PaymentChannelType {
  GCASH
  BANK_TRANSFER
  EWALLET
  CASH
}

// Admins choose whether a violation is only a warning or requires a payment.
enum ViolationKind {
  WARNING
  PAYMENT_REQUIRED
}

enum ViolationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum BudgetType {
  INCOME
  EXPENSE
}

enum NotificationType {
  DUE_REMINDER
  DUE_OVERDUE
  PAYMENT_RECEIVED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  FEEDBACK_REPLY
  GENERAL
}

enum ReminderKind {
  ONE_MONTH
  ONE_WEEK
  ONE_DAY
  OVERDUE
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         Role       @default(HOMEOWNER)
  status       UserStatus @default(ACTIVE)

  // One login per household. Admins have neither field set.
  householdId String?    @unique
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId    String?    @unique
  member      Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)

  sessions         Session[]
  notifications    Notification[]
  feedback         Feedback[]
  auditLogs        AuditLog[]            @relation("ActorAuditLogs")
  budgetEntries    BudgetEntry[]
  reviewedPayments Payment[]             @relation("PaymentReviewer")
  issuedViolations Violation[]           @relation("ViolationIssuer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Opaque session token: the raw token lives only in the browser cookie.
// We store a SHA-256 hash so a leaked database dump cannot be replayed.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Household {
  id          String      @id @default(cuid())
  unitAddress String      @unique
  street      String?
  block       String?
  lot         String?
  members     Member[]
  dues        Due[]
  account     User?
  violations  Violation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Block and lot identify the unit. Legacy rows may have null parts, and
  // PostgreSQL allows multiple nulls, so they do not collide.
  @@unique([block, lot])
  @@index([street])
  @@index([block, lot])
}

model Member {
  id             String            @id @default(cuid())
  householdId    String
  household      Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  contactNumber  String
  occupancyType  OccupancyType
  status         MemberStatus      @default(ACTIVE)
  consentVersion String?
  consentAt      DateTime?
  accountUser    User?
  kasambahay     Kasambahay[]
  pets           Pet[]
  vehicles       Vehicle[]
  occupants      HouseholdMember[]
  violations     Violation[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([householdId])
  @@index([lastName, firstName])
  @@index([contactNumber])
}

model Kasambahay {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName      String
  contactNumber String?
  createdAt     DateTime @default(now())

  @@index([memberId])
}

model Pet {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name      String
  breed     String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([memberId])
}

model Vehicle {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plateNumber String
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([memberId, plateNumber])
  @@index([memberId])
}

model HouseholdMember {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName     String
  relationship String?
  createdAt    DateTime @default(now())

  @@index([memberId])
}

model Due {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  periodStart DateTime      @db.Date
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime      @db.Date
  status      DueStatus     @default(UNPAID)
  payments    Payment[]
  reminders   ReminderLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([householdId, periodStart])
  @@index([status, dueDate])
}

// The HOA's own GCash account. The treasurer supplies display details and, when
// available, the official QR image. No uploads are stored in the app.
model PaymentChannel {
  id            String             @id @default(cuid())
  name          String
  type          PaymentChannelType
  accountName   String
  accountNumber String
  qrImageUrl    String?
  instructions  String?
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  payments      Payment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

// A payment is created as PENDING after the homeowner scans the HOA QR and
// submits the reference number. The treasurer verifies the transfer and either
// marks it PAID or rejects it with a reason.
model Payment {
  id              String          @id @default(cuid())
  dueId           String
  due             Due             @relation(fields: [dueId], references: [id], onDelete: Restrict)
  channelId       String?
  channel         PaymentChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  amount          Decimal         @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus   @default(PENDING)
  referenceNumber String          @unique
  receiptNumber   String?         @unique
  notes           String?
  paidAt          DateTime?
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([dueId])
  @@index([status])
  @@index([channelId])
}

// One row per reminder actually sent. dedupeKey keeps the daily job safe to
// re-run and lets us send the same reminder type more than once.
model ReminderLog {
  id        String       @id @default(cuid())
  dueId     String
  due       Due          @relation(fields: [dueId], references: [id], onDelete: Cascade)
  kind      ReminderKind
  dedupeKey String
  sentAt    DateTime     @default(now())

  @@unique([dueId, dedupeKey])
  @@index([dueId])
}

model BudgetEntry {
  id          String     @id @default(cuid())
  type        BudgetType
  category    String
  description String
  amount      Decimal    @db.Decimal(10, 2)
  occurredAt  DateTime   @db.Date
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([occurredAt])
  @@index([type])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String?
  message   String
  status    FeedbackStatus @default(NEW)
  adminNote String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status])
}

// A notice issued by the association to a household. Residents see open
// violations in the app, including directly below their dashboard greeting.
model Violation {
  id             String          @id @default(cuid())
  householdId    String
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  kind           ViolationKind   @default(WARNING)
  category       String
  description    String
  status         ViolationStatus @default(OPEN)
  fineAmount     Decimal?        @db.Decimal(10, 2)
  issuedAt       DateTime        @default(now())
  dueDate        DateTime?       @db.Date
  resolvedAt     DateTime?
  resolutionNote String?
  issuedById     String?
  issuedBy       User?           @relation("ViolationIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([householdId, status])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
