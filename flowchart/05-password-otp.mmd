%% Asian Leaf HOA - Chart 05
%% Chart F - password change / reset with OTP (planned feature)
flowchart TD
  PW1(["Start: user asks to change or reset the password"])
  PW2["Generate a 6-digit OTP, store only its hash, 5-minute TTL"]
  PW3["NOTIFY: send the code (email/SMS stub today)"]
  PW4[/"User enters the code and the new password"/]
  PW5{"Code valid, not expired,<br/>under 5 attempts?"}
  PW6[/"Incorrect or expired code"/]
  PW7{"New password meets the rule?<br/>8+ chars, upper, lower, number"}
  PW8[/"Password rule message"/]
  PW9[("Rehash and save the password,<br/>delete the OTP row")]
  PW10[("Delete ALL sessions for this user")]
  PW11["Issue a fresh session (change flow only)"]
  PW12(["End: signed in with the new password"])

  PW1 --> PW2 --> PW3 --> PW4 --> PW5
  PW5 -->|No| PW6 --> PW4
  PW5 -->|Yes| PW7
  PW7 -->|No| PW8 --> PW4
  PW7 -->|Yes| PW9 --> PW10 --> PW11 --> PW12
